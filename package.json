{
  "name": "terratwin",
  "private": true,
  "version": "0.3.0",
  "description": "Gêmeo digital agrícola 3D — demonstração com fazendas e dados fictícios",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "data:generate": "python scripts/generate_data.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
